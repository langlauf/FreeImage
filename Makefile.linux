.SUFFIXES: .cpp .o .c


VPATH = ./Source/FreeImageToolkit ./Source/LibTIFF ./Source/LibPNG ./Source/ZLib ./Source/LibMNG ./Source/LibJPEG ./Source/FreeImage
INSTALLDIR = /usr/lib

CC = gcc
CPP = g++
CC_FLAGS = -O3   
CPP_FLAGS = -O3 -finline-functions 
CC_INCLUDES = -ISource/LibJPEG -ISource/LibMNG -ISource/LibPNG -ISource/LibTIFF -ISource/ZLib
CPP_INCLUDES = -I./Source -ISource/FreeImageToolkit
CC_DEFINES = 
CPP_DEFINES = 
LIBRARIES = 
LINKER = ar
LINKER_FLAGS = 
LINKER_ENTRY = 

TARGET  = freeimage
VER_MAJOR = 3
VER_MINOR = 0.2
MODULES = BitmapAccess.o CacheFile.o Conversion.o Conversion16_555.o Conversion16_565.o Conversion24.o Conversion32.o Conversion8.o FreeImage.o FreeImageIO.o GetType.o Halftoning.o MultiPage.o NNQuantizer.o Plugin.o PluginBMP.o PluginCUT.o PluginICO.o PluginIFF.o PluginJPEG.o PluginKOALA.o PluginMNG.o PluginPCD.o PluginPCX.o PluginPNG.o PluginPNM.o PluginPSD.o PluginRAS.o PluginTARGA.o PluginTIFF.o PluginWBMP.o PluginXBM.o PluginXPM.o WuQuantizer.o ZLibInterface.o BSplineRotate.o ClassicRotate.o Colors.o CopyPaste.o Flip.o Rescale.o jcapimin.o jcapistd.o jccoefct.o jccolor.o jcdctmgr.o jchuff.o jcinit.o jcmainct.o jcmarker.o jcmaster.o jcomapi.o jcparam.o jcphuff.o jcprepct.o jcsample.o jctrans.o jdapimin.o jdapistd.o jdatadst.o jdatasrc.o jdcoefct.o jdcolor.o jddctmgr.o jdhuff.o jdinput.o jdmainct.o jdmarker.o jdmaster.o jdmerge.o jdphuff.o jdpostct.o jdsample.o jdtrans.o jerror.o jfdctflt.o jfdctfst.o jfdctint.o jidctflt.o jidctfst.o jidctint.o jidctred.o jmemmgr.o jmemnobs.o jpegtran.o jquant1.o jquant2.o jutils.o libmng_callback_xs.o libmng_chunk_io.o libmng_chunk_prc.o libmng_chunk_xs.o libmng_cms.o libmng_display.o libmng_dither.o libmng_error.o libmng_filter.o libmng_hlapi.o libmng_jpeg.o libmng_object_prc.o libmng_pixels.o libmng_prop_xs.o libmng_read.o libmng_trace.o libmng_write.o libmng_zlib.o png.o pngerror.o pnggccrd.o pngget.o pngmem.o pngpread.o pngread.o pngrio.o pngrtran.o pngrutil.o pngset.o pngtrans.o pngvcrd.o pngwio.o pngwrite.o pngwtran.o pngwutil.o fax3sm_winnt.o tif_aux.o tif_close.o tif_codec.o tif_compress.o tif_dir.o tif_dirinfo.o tif_dirread.o tif_dirwrite.o tif_dumpmode.o tif_error.o tif_extension.o tif_fax3.o tif_flush.o tif_getimage.o tif_jpeg.o tif_luv.o tif_lzw.o tif_next.o tif_open.o tif_packbits.o tif_pixarlog.o tif_predict.o tif_print.o tif_read.o tif_strip.o tif_swab.o tif_thunder.o tif_tile.o tif_version.o tif_warning.o tif_write.o tif_zip.o adler32.o compress.o crc32.o deflate.o gzio.o infblock.o infcodes.o inffast.o inflate.o inftrees.o infutil.o trees.o uncompr.o zutil.o

STATICLIB = lib$(TARGET).a
SHAREDLIB = lib$(TARGET)-$(VER_MAJOR).$(VER_MINOR).so
LIBNAME = lib$(TARGET).so.$(VER_MAJOR)

all: default

default: $(STATICLIB) $(SHAREDLIB)

.c.o:
	$(CC) -c $< $(CC_FLAGS) $(CC_DEFINES) $(CC_INCLUDES)

.cpp.o:
	$(CPP) -c $< $(CPP_FLAGS) $(CPP_DEFINES) $(CPP_INCLUDES)


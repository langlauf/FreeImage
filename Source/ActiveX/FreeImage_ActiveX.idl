// FreeImage_ActiveX.idl : IDL-Quellcode für FreeImage_ActiveX.dll
// Diese Datei wird mit dem MIDL-Tool bearbeitet,
// um den Quellcode für die Typbibliothek (FreeImage_ActiveX.tlb)und die Abruffunktionen zu erzeugen.

import "oaidl.idl";
import "ocidl.idl";
#include "olectl.h"

enum EnumIFreeimageXDispIDs
{
	dispid_SRC	= 1,
	dispid_ZOOM	= 2,
};

[
	uuid(AF709562-19F1-46C5-A1D6-BDE4C1954AE0),
	version(1.0),
	helpstring("FreeImage ActiveX Library (1.0)")
]
library FREEIMAGE_ACTIVEXLib
{
	importlib("stdole32.tlb");
	importlib("stdole2.tlb");

	//
	// Application
	//
	[
		object,
		uuid(D359BBEE-EB3D-4F7C-9663-389757252561),
		dual,
		helpstring("Freeimage Interface: FreeImage.Application"),
		pointer_default(unique)
	]
	interface IApplication : IDispatch
	{
		[id(1), helpstring("Methode Test")] HRESULT Test([in] BSTR msg, [in] BSTR title);
		[propget, id(2), helpstring("Eigenschaft Version")] HRESULT Version([out, retval] BSTR *pVal);
		[propget, id(3), helpstring("Eigenschaft Copyright")] HRESULT Copyright([out, retval] BSTR *pVal);
		[id(4), helpstring("Methode IsValidImage")] HRESULT IsValidImage([in] BSTR filename, [out, retval] short *pbIsValid);
		[propget, id(5), helpstring("Eigenschaft ShowMessages")] HRESULT ShowMessages([out, retval] short *pVal);
		[propput, id(5), helpstring("Eigenschaft ShowMessages")] HRESULT ShowMessages([in] short newVal);
		[id(6), helpstring("Methode GetImageType")]		HRESULT GetImageType([in] short flags, [in] BSTR filename, [out, retval] short *pVal);
		[propget, id(7), helpstring("Eigenschaft SupportsReading")] HRESULT SupportsReading([in] short type, [out, retval] short *pVal);
		[propget, id(8), helpstring("Eigenschaft SupportsWriting")] HRESULT SupportsWriting([in] short type, [out, retval] short *pVal);
	};

	[
		uuid(8A214157-8E32-4ED8-A025-C9B6758B5E1B),
		helpstring("Freeimage Events: FreeImage.Application")
	]
	dispinterface _IApplicationEvents
	{
		properties:
		methods:
	};
	
	[
		uuid(32CAAACB-B36E-47E0-A388-93AE3C1A6C82),
		helpstring("Freeimage Interface: FreeImage.Application")
	]
	coclass Application
	{
		[default] interface IApplication;
		[default, source] dispinterface _IApplicationEvents;
	};

	//
	// Image
	//
	[
		object,
		uuid(6F9584CB-3DDB-457B-8E8A-740936F5B2FF),
		dual,
		helpstring("Freeimage Interface: FreeImage.Image"),
		pointer_default(unique)
	]
	interface IImage : IDispatch
	{
		[id(1), helpstring("Methode Test")] HRESULT Test([in] BSTR msg, [in] BSTR title);
		[id(2), helpstring("Methode Open")] HRESULT Open([in] BSTR filename, [out, retval] short *pbSuccess);
		[id(3), helpstring("Methode Save")] HRESULT Save([in] BSTR filename, [out, retval] short *pbSuccess);
		[id(4), helpstring("Methode Close")] HRESULT Close();
		[propget, id(5), helpstring("Eigenschaft Resolution x")] HRESULT ResolutionX([out, retval] double *pVal);
		[propput, id(5), helpstring("Eigenschaft Resolution x")] HRESULT ResolutionX([in] double newVal);
		[propget, id(6), helpstring("Eigenschaft Resolution y")] HRESULT ResolutionY([out, retval] double *pVal);
		[propput, id(6), helpstring("Eigenschaft Resolution y")] HRESULT ResolutionY([in] double newVal);
		[id(7), helpstring("Methode OpenEx")] HRESULT OpenEx([in] short type, [in] BSTR filename, [in] short params, [out, retval] short *pbSuccess);
		[id(8), helpstring("Methode SaveEx")] HRESULT SaveEx([in] short type, [in] BSTR filename, [in] short params, [out, retval] short *pbSuccess);
		[propget, id(9), helpstring("Eigenschaft Width")] HRESULT Width([out, retval] long *pVal);
		[propget, id(10), helpstring("Eigenschaft Height")] HRESULT Height([out, retval] long *pVal);
		[propget, id(11), helpstring("Eigenschaft BPP")] HRESULT BPP([out, retval] long *pVal);
		[propget, id(12), helpstring("Eigenschaft DIBSize")] HRESULT DIBSize([out, retval] long *pVal);
		[propget, id(13), helpstring("Eigenschaft RedMask")] HRESULT RedMask([out, retval] long *pVal);
		[propget, id(14), helpstring("Eigenschaft GreenMask")] HRESULT GreenMask([out, retval] long *pVal);
		[propget, id(15), helpstring("Eigenschaft BlueMask")] HRESULT BlueMask([out, retval] long *pVal);
		[propget, id(16), helpstring("Eigenschaft ColorsUsed")] HRESULT ColorsUsed([out, retval] long *pVal);
		[propget, id(17), helpstring("Eigenschaft ColorType")] HRESULT ColorType([out, retval] short *pVal);
		[propget, id(18), helpstring("Eigenschaft IsTransparent")] HRESULT IsTransparent([out, retval] short *pVal);
		[id(19), helpstring("Methode ChangeColors")]	HRESULT ChangeColors([in] short colors, [in] short param, [out, retval] short *pVal);
		[id(20), helpstring("Methode Clone")]		HRESULT Clone([out, retval] IImage **ppImage);
		[id(21), helpstring("Methode FromHandle")] HRESULT FromHandle([in] LPUNKNOWN pHandle);
	};

	[
		uuid(2FC39DC8-1E37-4550-AE17-0B7BA1E5A9D8),
		helpstring("Freeimage Events: FreeImage.Image")
	]
	dispinterface _IImageEvents
	{
		properties:
		methods:
	};
	[
		uuid(4E54B27F-895D-4B6C-8F37-621FA0FC4018),
		helpstring("Freeimage Interface: FreeImage.Image")
	]
	coclass Image
	{
		[default] interface IImage;
		[default, source] dispinterface _IImageEvents;
	};


	//
	// Multipage
	//
	[
		object,
		uuid(DD57DFFB-4F5C-4E0A-9CB7-ACC72DB83D6D),
		dual,
		helpstring("Freeimage Interface: FreeImage.Multipage"),
		pointer_default(unique)
	]
	
	interface IMultipage : IDispatch
	{
		[id(1), helpstring("Methode Test")] HRESULT Test([in] BSTR msg, [in] BSTR title);
	};

	[
		uuid(58FF1147-89E7-4243-BAEE-0855276181D1),
		helpstring("Freeimage Events: FreeImage.Multipage")
	]
	dispinterface _IMultipageEvents
	{
		properties:
		methods:
	};

	[
		uuid(557B6D32-B508-4CDB-AF73-CF9B1C9D8B40),
		helpstring("Freeimage Interface: FreeImage.Multipage")
	]
	coclass Multipage
	{
		[default] interface IMultipage;
		[default, source] dispinterface _IMultipageEvents;
	};


	//
	// Painting
	//
	[
		object,
		uuid(8FD8673F-8191-45B9-914F-E23E92413437),
		dual,
		helpstring("Freeimage Interface: FreeImage.Painting"),
		pointer_default(unique)
	]
	interface IPainting : IDispatch
	{
		[propput, id(DISPID_AUTOSIZE)]
		HRESULT AutoSize([in]VARIANT_BOOL vbool);
		[propget, id(DISPID_AUTOSIZE)]
		HRESULT AutoSize([out,retval]VARIANT_BOOL* pbool);
		[propput, id(DISPID_ENABLED)]
		HRESULT Enabled([in]VARIANT_BOOL vbool);
		[propget, id(DISPID_ENABLED)]
		HRESULT Enabled([out,retval]VARIANT_BOOL* pbool);
		[propput, id(DISPID_VALID)]
		HRESULT Valid([in]VARIANT_BOOL vbool);
		[propget, id(DISPID_VALID)]
		HRESULT Valid([out, retval]VARIANT_BOOL* pbool);
		
		[propget, id(dispid_SRC)]  HRESULT SRC([out, retval] BSTR *pVal);
		[propput, id(dispid_SRC)]  HRESULT SRC([in] BSTR newVal);
		[propget, id(dispid_ZOOM)] HRESULT Zoom([out, retval] double *pVal);
		[propput, id(dispid_ZOOM)] HRESULT Zoom([in] double newVal);
	};
	[
		uuid(CA4D1C39-9335-4622-9F49-5B6D965DACC6),
		helpstring("Freeimage Interface: FreeImage.Painting")
	]
	coclass Painting
	{
		[default] interface IPainting;
	};
};
